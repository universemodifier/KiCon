(version 1)
(rule "JLCPCB pad hole to hole"
	(constraint hole_to_hole (min 0.45mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad'")
)
(rule "JLCPCB PTH hole to track"
	(constraint hole_clearance (min 0.28mm))
	(condition "A.Pad_Type == 'Through-hole' && B.Type == 'Track'")
)
(rule "JLCPCB SMD pad to pad"
	(constraint clearance (min 0.15mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'")
)
(rule "JLCPCB inner PTH hole to copper"
	(layer inner)
	(constraint hole_clearance (min 0.3mm))
	(condition "A.Pad_Type == 'Through-hole'")
)
